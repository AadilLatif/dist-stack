{
  "schema_version": 1,
  "workflow_id": "assistant_demo_flow",
  "version": "1.0.0",
  "name": "Run LinDistFlow on a registered model",
  "description": "Runs LinDistFlow (gdm_flow.opf_run_lindistflow) on a GDM DistributionSystem referenced by its registry model_id.",
  "inputs": [
    {
      "name": "model_id",
      "type": "string",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "step_1",
      "server": "gdm_flow",
      "tool": "opf_run_lindistflow",
      "args": {
        "model_ref": {
          "model_id": "${model_id}",
          "version": 1
        }
      },
      "capture": "step_1",
      "on_failure": "fail"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "from": "step_1"
    }
  ]
}
