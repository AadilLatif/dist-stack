# dist-dashboard LLM secrets — copy to .streamlit/secrets.toml and fill in.
# .streamlit/secrets.toml is git-ignored; never commit a real key.
#
# The assistant reads the [llm] block here, but env vars win:
#   LLM_BASE_URL  LLM_API_KEY  LLM_MODEL

[llm]
base_url = "https://api.openai.com/v1"   # or http://localhost:8000/v1 (vLLM) / :11434/v1 (Ollama)
api_key = "sk-..."                        # never commit
model = "gpt-4o-mini"
